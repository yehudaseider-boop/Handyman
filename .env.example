# Copy to .env for local development only. Never commit .env or credentials.
APP_MODE=demo
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DB_PATH=data/demo.sqlite

# Live: use a separate DB, HTTPS origin, secure cookies, and secret-manager values.
# NODE_ENV=production
# APP_MODE=live
# APP_ORIGIN=https://your-workspace.example
# DB_PATH=data/live.sqlite
# ADMIN_EMAIL=operator@your-business.example
# ADMIN_PASSWORD=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Optional controlled automatic reception: keep the live gate off until phone testing.
# Approval and the operator enable control are also required.
# ALLOW_LIVE_AUTOMATION=0

# Optional real AI draft generation. Drafts always require operator approval.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
